# Optional deployment defaults. Copy this file to .env for local use.

# The default command is a mock smoke session and needs no model service.
HARNESS_PROVIDER=mock
HARNESS_GOAL=Explore the sandbox workspace

# Leave empty for local checkout builds. For release mode, set a published image
# or pass --release/--image to deploy.sh or deploy.ps1.
HARNESS_IMAGE=
HARNESS_BUILD_TARGET=runtime

HARNESS_DEFAULT_ENERGY=100
HARNESS_LOCAL_MODEL_URL=http://host.docker.internal:8000/v1
HARNESS_EXTERNAL_MODEL_URL=
HARNESS_LOCAL_MODEL_NAME=local-model
HARNESS_EXTERNAL_MODEL_NAME=

# Keep credentials only in your local .env or shell environment.
HARNESS_LOCAL_MODEL_KEY=
HARNESS_EXTERNAL_MODEL_KEY=
