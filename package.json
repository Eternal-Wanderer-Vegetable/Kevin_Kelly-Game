{
  "name": "evolving-coding-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "harness": "dist/scripts/harness.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "deploy": "node deploy.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tui.json --noEmit && tsc -p tsconfig.webui.json",
    "build": "tsc && tsc -p tsconfig.tui.json && vite build",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev:web": "vite",
    "harness": "tsx scripts/harness.ts",
    "run-task": "tsx scripts/run-task.ts",
    "run-repair": "tsx scripts/run-repair.ts",
    "run-generation": "tsx scripts/run-generation.ts",
    "replay-run": "tsx scripts/replay-run.ts",
    "report": "tsx scripts/report.ts",
    "webui": "tsx scripts/webui.ts"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "react-dom": "19.2.8",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
