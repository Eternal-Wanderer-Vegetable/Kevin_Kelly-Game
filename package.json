{
  "name": "evolving-coding-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "run-task": "tsx scripts/run-task.ts",
    "replay-run": "tsx scripts/replay-run.ts",
    "report": "tsx scripts/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
